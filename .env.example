# --- Groq Reasoning Engine ---
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"              # Primary LLM (e.g. openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_GUARD_MODEL="openai/gpt-oss-20b"         # Lightweight fast model for NeMo Guardrails
GROQ_FALLBACK_API_KEY=""                      # Optional: secondary Groq API key
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"      # Fallback model on failure/rate-limit

# --- Portkey LLM Gateway (Optional) ---
PORTKEY_API_KEY=""                            # If empty, the app automatically runs directly against Groq
PORTKEY_CONFIG_ID=""                          # Optional: Portkey saved config ID (e.g. pc-...)
PORTKEY_GROQ_SLUG="rag"                       # Primary virtual key slug in Portkey
PORTKEY_GROQ_SLUG_FALLBACK="brag"             # Fallback virtual key slug in Portkey

# --- Qdrant Vector DB Settings ---
# Leave empty to automatically use local disk storage (./local_qdrant)
QDRANT_API_KEY=""
QDRANT_CLUSTER_ENDPOINT=""                    # e.g. https://your-cluster.cloud.qdrant.io:6333

# --- Gemini Embeddings ---
GEMINI_API_KEY=""

# --- Observability ---
# Pydantic Logfire
LOGFIRE_TOKEN=""

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="rag_scale_test"

# --- Backend URL (for Streamlit UI) ---
BACKEND_URL="http://localhost:8000"

# --- Eval Suite (Optional) ---
JUDGE_GROQ=""                                 # Dedicated Groq key for RAGAS evaluation judge
JUDGE_MODEL="openai/gpt-oss-20b"
